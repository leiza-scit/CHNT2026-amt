@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix nfdi_fw: <http://w3id.org/fw_ontology/> .

# =============================================================================
# DRAFT, to be moved into the FW ontology (caa-datadragons/FW_Ontology)
# =============================================================================
#
# The target of amt:method in a hextuple. The names (WeightMethod, formula,
# implementation, ReciprocalPossibilityWeight) are proposals. The rule is
# implemented in py/weights.py of this repository; the self-test there is the
# executable form of the table below.
#
# amt:type of the same hextuple points at an FW class:
#   nfdi_fw:UncertainValue, nfdi_fw:VagueValue, nfdi_fw:FuzzinessWobblinessValue
# =============================================================================

nfdi_fw:WeightMethod a owl:Class ;
    rdfs:label "Weight method"@en ;
    rdfs:comment "A rule by which the degree of connection (amt:weight) of a statement is obtained from its source expression."@en .

nfdi_fw:formula a owl:DatatypeProperty ;
    rdfs:domain nfdi_fw:WeightMethod ;
    rdfs:range  xsd:string ;
    rdfs:comment "The rule in a short, executable notation."@en .

nfdi_fw:implementation a owl:ObjectProperty ;
    rdfs:domain nfdi_fw:WeightMethod ;
    rdfs:comment "Where the rule is implemented and tested."@en .

nfdi_fw:ReciprocalPossibilityWeight a nfdi_fw:WeightMethod ;
    rdfs:label "Reciprocal possibility weight"@en ;
    skos:definition "The weight of every entity of a statement is the reciprocal of the number of possibilities plus one if the statement carries a question mark."@en ;
    nfdi_fw:formula "amt_weight = 1 / (n_questionmark + n_possibilities), rounded to two decimals" ;
    skos:scopeNote """n_questionmark is 1 if the source expression contains a question mark, else 0. n_possibilities is 1 for an expression without OR and for an AND expression (all entities hold, each keeps the full weight), and the number of entities for an OR expression. An expression that mixes AND and OR is not covered. A question mark leaves one share to 'none of the listed': 'A or B?' gives one third to each of A and B."""@en ;
    skos:example "'Kräherwald and Rheinzabern' gives 1.0 each; 'Pfaffenhofen or Westerndorf' gives 0.5 each; '24 or 27 or 33' gives 0.33 each; '32?' gives 0.5; 'La Graufesenque and Le Rozier?' gives 0.5 each; 'dish or bowl?' gives 0.33 each."@en ;
    dcterms:source "Thiery, F., Mees, A., Tolle, K. and Wigg-Wolf, D. (2021). How to handle vagueness and uncertainty in graph-based LOD knowledge modelling, section 4." ;
    nfdi_fw:implementation <https://github.com/leiza-scit/CHNT2026-amt/blob/main/py/weights.py> .
